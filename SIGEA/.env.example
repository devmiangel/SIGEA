# Copiar a SIGEA/.env y completar. Nunca subir .env al repositorio.

# --- Django ---
# Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# True solo en desarrollo
DJANGO_DEBUG=False
# Separados por coma, sin espacios ni esquema. Ej: sigea.midominio.com
DJANGO_ALLOWED_HOSTS=sigea.midominio.com
# Con esquema. Necesario para /admin/ detrás de HTTPS
CSRF_TRUSTED_ORIGINS=https://sigea.midominio.com
# Front y API en el mismo dominio -> vacío. En desarrollo: http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- Base de datos (PostgreSQL) ---
DB_NAME=SIGEA_DB
DB_USER=sigea
DB_PASSWORD=cambiar-por-una-contraseña-segura
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Tokens Knox ---
# Minutos de inactividad antes de que el token expire (se renueva con cada uso)
KNOX_TOKEN_TTL_MINUTES=600

# --- Seguridad HTTPS (solo aplica con DJANGO_DEBUG=False) ---
DJANGO_SECURE_SSL_REDIRECT=True
# Empezar bajo (3600) y subir a 31536000 cuando HTTPS esté verificado
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# --- Opcionales ---
DJANGO_LOG_LEVEL=INFO
DJANGO_LANGUAGE_CODE=es-co
DJANGO_TIME_ZONE=America/Bogota

# --- Límites anti abuso (throttling) ---
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
# Intentos de login por IP y por email
THROTTLE_LOGIN=5/min
THROTTLE_LOGIN_EMAIL=10/hour
THROTTLE_REGISTER=10/hour
# Proxies delante de Django (Nginx = 1) para obtener la IP real del cliente
NUM_PROXIES=1

# --- Archivos ---
# Adjuntos privados de UPs (fuera de media/, nunca servidos directamente por Nginx)
PRIVATE_MEDIA_ROOT=/srv/sigea/private_media
# True en producción: Django delega la descarga a Nginx (location internal /protected/)
USE_X_ACCEL_REDIRECT=True
# Tamaño máximo por archivo (MB). Debe ser <= client_max_body_size de Nginx
MAX_UPLOAD_MB=5
