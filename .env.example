# ==========================================================
# SIGEA - Variables de entorno para Docker Compose
#
# Copia este archivo como ".env" y rellena los valores reales:
#     cp .env.example .env
#
# El archivo ".env" NO se sube al repositorio (esta en .gitignore).
# ==========================================================

# ----------------------------------------------------------
# Django
# ----------------------------------------------------------
# Genera una nueva clave secreta con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# IMPORTANTE: en produccion SIEMPRE debe ser False.
DJANGO_DEBUG=False

# Hosts permitidos (separados por coma). Incluye tu dominio y la IP del VPS.
DJANGO_ALLOWED_HOSTS=tudominio.com,www.tudominio.com,IP_DEL_VPS

# CORS: con front y API en el mismo dominio puede quedar vacio.
CORS_ALLOWED_ORIGINS=

# Origenes de confianza para CSRF (necesario para /admin/ detras de HTTPS).
CSRF_TRUSTED_ORIGINS=https://tudominio.com,https://www.tudominio.com

# ----------------------------------------------------------
# PostgreSQL (contenedor "db")
# ----------------------------------------------------------
# El host se fija a "db" dentro de docker-compose.yml.
DB_NAME=SIGEA_DB
DB_USER=sigea
DB_PASSWORD=cambia-esta-clave-de-base-de-datos

# ----------------------------------------------------------
# Cache compartida (los limites de intentos se cuentan aqui).
# Docker Compose levanta el servicio "redis"; vacio = cache por proceso.
# ----------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ----------------------------------------------------------
# Tokens Knox y limites anti abuso
# ----------------------------------------------------------
KNOX_TOKEN_TTL_MINUTES=600
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=5/min
THROTTLE_LOGIN_EMAIL=10/hour
THROTTLE_REGISTER=10/hour
# Proxies delante de Django (nginx del host + nginx del contenedor = 2)
NUM_PROXIES=2

# ----------------------------------------------------------
# Archivos
# ----------------------------------------------------------
# Django delega la descarga de adjuntos privados a nginx (X-Accel-Redirect).
USE_X_ACCEL_REDIRECT=True
# Tamano maximo por archivo subido (MB). Debe ser <= client_max_body_size de nginx.
MAX_UPLOAD_MB=5

# ----------------------------------------------------------
# Seguridad HTTPS (dejar en True si publicas con TLS/certificado)
# ----------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# ----------------------------------------------------------
# Logs / idioma
# ----------------------------------------------------------
DJANGO_LOG_LEVEL=INFO
DJANGO_LANGUAGE_CODE=es-co
DJANGO_TIME_ZONE=America/Bogota

# ----------------------------------------------------------
# Docker Compose / servidor
# ----------------------------------------------------------
# Puerto local (127.0.0.1) donde el contenedor frontend expone nginx.
# El nginx del host hara proxy a 127.0.0.1:8080 y manejara TLS (443).
# No se publica a Internet directamente.
HTTP_PORT=8080

# Cantidad de workers de gunicorn (regla: 2 x nucleos + 1).
GUNICORN_WORKERS=3

# Ejecuta los seeders (seed + seed_permisos) al arrancar el backend.
# Ponlo en "true" SOLO la primera vez; luego vuelve a "false" (son idempotentes).
RUN_SEEDERS=false
