# ==========================================================
# SIGEA - Variables de entorno para Docker Compose
#
# Copia este archivo como ".env" y rellena los valores reales:
#     cp .env.example .env
#
# El archivo ".env" NO se sube al repositorio (esta en .gitignore).
# ==========================================================

# ----------------------------------------------------------
# Django
# ----------------------------------------------------------
# Genera una nueva clave secreta con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria

# IMPORTANTE: en produccion SIEMPRE debe ser False.
DJANGO_DEBUG=False

# Hosts permitidos (separados por coma). Incluye tu dominio y la IP del VPS.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,tudominio.com,www.tudominio.com

# Origenes permitidos para CORS (con esquema http/https).
# Con nginx en el mismo dominio normalmente no se necesita, pero se deja
# configurable para entornos donde el front y la API esten separados.
CORS_ALLOWED_ORIGINS=http://localhost,http://tudominio.com,https://tudominio.com,https://www.tudominio.com

# Origenes de confianza para CSRF (necesario para el admin de Django).
CSRF_TRUSTED_ORIGINS=http://localhost,http://tudominio.com,https://tudominio.com,https://www.tudominio.com

# ----------------------------------------------------------
# PostgreSQL (contenedor "db")
# ----------------------------------------------------------
POSTGRES_DB=SIGEA_DB
POSTGRES_USER=sigea
POSTGRES_PASSWORD=cambia-esta-clave-de-base-de-datos

# Host = nombre del servicio de la base de datos en docker-compose.
# NO lo cambies si usas el docker-compose.yml incluido.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----------------------------------------------------------
# Docker Compose / servidor
# ----------------------------------------------------------
# Puerto local (127.0.0.1) donde el contenedor frontend expone nginx.
# El nginx del host hara proxy a 127.0.0.1:8080 y manejara TLS (443).
# No se publica a Internet directamente.
HTTP_PORT=8080

# Cantidad de workers de gunicorn (regla: 2 x nucleos + 1).
GUNICORN_WORKERS=3

# Ejecuta los seeders (seed + seed_permisos) al arrancar el backend.
# Ponlo en "true" SOLO la primera vez; luego vuelve a "false" (son idempotentes).
RUN_SEEDERS=false

# ----------------------------------------------------------
# HTTPS (activar SOLO si publicas el sitio con TLS/certificado)
# ----------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
